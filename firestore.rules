rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    // Only accounts that signed in with Google are allowed.
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admins are listed in the `admins` collection (doc id = user uid).
    // Add them by hand in the Firebase Console; the app can never write there.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Admins (read-only from the app) ----------
    match /admins/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // ---------- Users ----------
    function validProfile(data) {
      return (!('username' in data) || (data.username is string && data.username.matches('^[a-z0-9._]{3,20}$')))
        && (!('display_name' in data) || (data.display_name is string && data.display_name.size() <= 40))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 200))
        && (!('profile_img_url' in data) || (data.profile_img_url is string && data.profile_img_url.size() <= 300000));
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(userId) && validProfile(request.resource.data);
      allow delete: if false;

      // Friend list entries: users/{owner}/friends/{other}
      //   status 'sent'     = owner sent a request to other
      //   status 'pending'  = other sent a request to owner (waiting for owner)
      //   status 'accepted' = friends
      // Nobody can make themselves someone's friend without that person accepting.
      match /friends/{friendId} {
        allow read: if isSelf(userId);
        allow create: if (isSelf(userId) && request.resource.data.status == 'sent')
                      || (isSelf(friendId) && request.resource.data.status == 'pending');
        allow update: if (isSelf(userId) && resource.data.status == 'pending' && request.resource.data.status == 'accepted')
                      || (isSelf(friendId) && resource.data.status == 'sent' && request.resource.data.status == 'accepted');
        allow delete: if isSelf(userId) || isSelf(friendId);
      }
    }

    // ---------- Parties ----------
    match /parties/{partyId} {
      allow read: if isSignedIn();
      function validPlayerCount() {
        return request.resource.data.playersCurrent is int
          && request.resource.data.playersCurrent >= 0
          && request.resource.data.playersCurrent <= request.resource.data.playersMax;
      }
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.playersCurrent == 1
        && request.resource.data.playersMax is int
        && request.resource.data.playersMax >= 2
        && request.resource.data.playersMax <= 100;
      // Host can edit everything (but can't hand the party to someone else).
      // Anyone else can only join/leave: change members and the player count by 1.
      // Nobody can push the count past the limit.
      allow update: if isSignedIn() && validPlayerCount() && (
        (resource.data.hostUid == request.auth.uid
          && request.resource.data.hostUid == resource.data.hostUid)
        || (changedOnly(['members', 'playersCurrent'])
          && (request.resource.data.playersCurrent - resource.data.playersCurrent) in [1, -1])
      );
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }

    // ---------- Live locations ----------
    match /active_locations/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(uid) && request.resource.data.uid == uid;
      allow delete: if isSelf(uid);
    }

    // ---------- Chats ----------
    // Direct chats use the id "<uidA>_<uidB>". Group/party chats have a `members` list.
    match /chats/{chatId} {
      // Direct chats have ids like "uidA_uidB"; group/party chats have random ids.
      function isDirectChat() {
        return chatId.split('_').size() == 2;
      }
      function isDirectParticipant() {
        return isSignedIn() && isDirectChat() && request.auth.uid in chatId.split('_');
      }
      function isMember() {
        return isSignedIn()
          && !isDirectChat()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
      // A direct chat's members must be exactly the two people in its id.
      // Group name/photo must be a sensible size.
      function validChat(d) {
        return d.members is list
          && d.members.size() <= 50
          && (!isDirectChat() || d.members.toSet() == chatId.split('_').toSet())
          && (!('name' in d) || (d.name is string && d.name.size() <= 50))
          && (!('avatarUrl' in d) || (d.avatarUrl is string && d.avatarUrl.size() <= 300000));
      }
      function canAccessChat() {
        return isDirectParticipant() || isMember();
      }

      allow read: if isSignedIn() && (
        request.auth.uid in chatId.split('_') || request.auth.uid in resource.data.members
      );
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.members
        && validChat(request.resource.data);
      allow update: if isSignedIn() && validChat(request.resource.data) && (
        // Members can rename the group, change its photo, add friends,
        // update the last-message preview and unread counts, etc.
        request.auth.uid in resource.data.members
        // Joining a party adds you to its chat (only yourself, only party chats).
        || (!isDirectChat()
          && exists(/databases/$(database)/documents/parties/$(chatId))
          && changedOnly(['members'])
          && request.resource.data.members.toSet()
               .difference(resource.data.members.toSet()).hasOnly([request.auth.uid]))
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canAccessChat();
        allow create: if canAccessChat() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // ---------- Voice / video calls ----------
    // calls/{callId}: participants = everyone in the chat, joined = in the call now,
    // activeFor = who still sees it ringing / joinable.
    match /calls/{callId} {
      function chatPath(chatId) {
        return /databases/$(database)/documents/chats/$(chatId);
      }
      // Participants must exactly match the chat: the two people of a direct
      // chat ("uidA_uidB"), or the members of a group chat.
      function matchesChat(d) {
        return (d.isGroup == false
                 && d.chatId.split('_').size() == 2
                 && d.participants.toSet() == d.chatId.split('_').toSet())
            || (d.isGroup == true
                 && exists(chatPath(d.chatId))
                 && get(chatPath(d.chatId)).data.members.toSet() == d.participants.toSet());
      }
      function onlyMeChanged(field) {
        return request.resource.data[field].toSet().difference(resource.data[field].toSet()).hasOnly([request.auth.uid])
          && resource.data[field].toSet().difference(request.resource.data[field].toSet()).hasOnly([request.auth.uid]);
      }

      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participants
        || request.auth.uid in resource.data.activeFor
      );
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 12
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.joined == [request.auth.uid]
        && request.resource.data.declined == []
        && request.resource.data.activeFor.toSet() == request.resource.data.participants.toSet()
        && request.resource.data.status == 'ringing'
        && request.resource.data.type in ['audio', 'video']
        && matchesChat(request.resource.data);
      // Participants can join/leave themselves, decline, mark it active/ended,
      // and remove people from activeFor (never add). Nothing else changes.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && changedOnly(['joined', 'declined', 'activeFor', 'status', 'answeredAt'])
        && onlyMeChanged('joined')
        && onlyMeChanged('declined')
        && request.resource.data.activeFor.toSet().difference(resource.data.activeFor.toSet()).size() == 0
        && request.resource.data.status in ['ringing', 'active', 'ended']
        && !(resource.data.status == 'ended' && request.resource.data.status != 'ended');
      allow delete: if false;

      // Connection details exchanged between two people in the call.
      match /signals/{signalId} {
        function callData() {
          return get(/databases/$(database)/documents/calls/$(callId)).data;
        }
        allow create: if isSignedIn()
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in callData().participants
          && request.resource.data.to in callData().participants
          && request.resource.data.type in ['offer', 'answer', 'candidate'];
        allow read: if isSignedIn() && resource.data.to == request.auth.uid;
        allow delete: if isSignedIn()
          && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      }
    }

    // ---------- Legacy chat/friend collections (old ChatView) ----------
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    match /friend_requests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
      allow update: if isSignedIn() && resource.data.to == request.auth.uid;
    }

    // ---------- Admin-managed content ----------
    match /venues/{venueId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sports/{sportId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- Settings > connection diagnostic ----------
    match /connection_test/{docId} {
      allow read, create: if isSignedIn();
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
