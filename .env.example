# Copy this file to .env and fill in your values. Never commit .env.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Configuration
# Get these from: https://console.firebase.google.com/ > Project Settings > General > Your Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: a relay (TURN) server so calls still connect on strict networks
# (some mobile data and office/school Wi-Fi). Without it, calls between some
# networks connect but stay silent, or fail. Several URLs can be comma-separated.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
